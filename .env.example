# All settings are optional for local use. No database is required.

# Required before exposing this app beyond a trusted local environment.
# The dashboard prompts for this key when configured; it is kept only in memory.
LEADHUNTER_API_TOKEN=

# Must implement the Nominatim search API. Public service use must follow its policy.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Archive rescue runs only after an unreadable website. Snapshots can be outdated.
SCRAPER_ARCHIVE_ENABLED=true
# Optional trusted service: accepts POST {"url":"https://business.example/"}, returns HTML.
# Must enforce SSRF protections on its own browser navigation, redirects, and subresources.
# Used only when the user enables the renderer checkbox for JavaScript-only sites.
SCRAPER_RENDERER_URL=
