# Environment Variables Template — LeadHunter
# Copy this file to .env or .env.local and fill in your Supabase project credentials.

# ─── Supabase (Required for data persistence) ─────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NOTE: Discovery engine uses OpenStreetMap (Nominatim + Overpass QL).
# No Google Cloud account, API key, or credit card is required.

# The deployed application uses the original live discovery/enrichment routes.
